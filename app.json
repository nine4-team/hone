{
  "expo": {
    "name": "HitList",
    "slug": "hitlist",
    "scheme": "hitlist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.benjaminmackenzie.hitlist",
      "supportsTablet": true
    },
    "android": {
      "package": "com.benjaminmackenzie.hitlist",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "appGroupId": "group.com.benjaminmackenzie.hitlist",
            "extensionBundleIdentifier": "com.benjaminmackenzie.hitlist.expo-sharing-extension",
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsWebPageWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/*"
            ]
          }
        }
      ]
    ]
  }
}
