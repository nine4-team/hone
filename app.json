{
  "expo": {
    "name": "HitList",
    "slug": "hitlist",
    "scheme": "hitlist",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.benjaminmackenzie.hitlist",
      "supportsTablet": true,
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.benjaminmackenzie.hitlist"
        ]
      },
      "infoPlist": {
        "CFBundleDisplayName": "HitList",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.benjaminmackenzie.hitlist",
      "adaptiveIcon": {
        "backgroundColor": "#1A1A1A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-sharing",
        {
          "ios": {
            "enabled": true,
            "appGroupId": "group.com.benjaminmackenzie.hitlist",
            "extensionBundleIdentifier": "com.benjaminmackenzie.hitlist.expo-sharing-extension",
            "activationRule": {
              "supportsText": true,
              "supportsWebUrlWithMaxCount": 1,
              "supportsWebPageWithMaxCount": 1
            }
          },
          "android": {
            "enabled": true,
            "singleShareMimeTypes": [
              "text/*"
            ]
          }
        }
      ],
      "expo-sqlite"
    ],
    "extra": {
      "router": {},
      "eas": {
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "expo-sharing-extension",
                  "bundleIdentifier": "com.benjaminmackenzie.hitlist.expo-sharing-extension",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.benjaminmackenzie.hitlist"
                    ]
                  }
                }
              ]
            }
          }
        },
        "projectId": "7030d68c-7b08-49de-8d89-682e0f9f60d4"
      }
    },
    "owner": "nine4-team"
  }
}
